{
    "id": "io.github.flattool.Warehouse",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "warehouse",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland",
        "--talk-name=org.freedesktop.Flatpak",
        "--filesystem=/var/lib/flatpak/:ro",
        "--filesystem=~/.local/share/flatpak/:ro",
        "--filesystem=~/.var/app/",
        "--filesystem=host-etc"
    ],
    "modules": [
        {
            "name": "warehouse",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/flattool/warehouse.git",
                    "tag": "2.2.0",
                    "commit": "4e45cb52caa7a32717b2037f4b0fb8a331c9e7c6"
                }
            ]
        }
    ]
}
